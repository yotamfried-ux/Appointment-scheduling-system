{
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-env.mjs --if-production && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:journeys": "playwright test --project=journeys",
    "test:e2e": "playwright test",
    "db:start": "supabase start -x studio,imgproxy,logflare,vector,edge-runtime,storage-api,realtime,postgres-meta,supavisor",
    "db:stop": "supabase stop",
    "db:test": "supabase test db",
    "db:lint": "docker exec supabase_db_appointment-scheduling-system psql -U postgres -At -c \"select rule, object_name from private.lint_violations()\"",
    "check": "npm run lint && npm run typecheck && npm test",
    "graph:build": "graphify extract . --code-only",
    "check:bundle": "bash scripts/check-bundle.sh --self-test && bash scripts/check-bundle.sh",
    "check:env": "node scripts/check-env.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-hebrew": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.53.0",
    "next": "^16.4.2",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.2",
    "fast-check": "^4.10.2",
    "jsdom": "^29.1.1",
    "postcss": "^8",
    "supabase": "^2.120.0",
    "svix": "^2.8.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "name": "appointment-scheduling-system",
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "playwright-core": "1.64.0",
    "fast-uri": "3.1.9",
    "undici": "7.30.1"
  }
}
