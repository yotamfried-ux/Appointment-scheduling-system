# Copy to .env.local (never commit real values). See docs/05 §5.7.

# Public (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Server-only secrets. Added with the modules that need them:
# SUPABASE_SECRET_KEY=            # stage 2, only imported from platform/system-db
# RESEND_API_KEY=                 # stage 6 (sending-only key, one per environment)
# RESEND_WEBHOOK_SECRET=          # stage 6
# TOKEN_SIGNING_KEYS=             # stage 4, JSON [{"kid":"1","key":"..."}]
# CRON_SECRET=                    # stage 6
