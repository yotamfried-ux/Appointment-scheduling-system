# Copy to .env.local (never commit real values). See docs/05 §5.7.

# Public (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Server-only secrets (never commit real values; one set per environment — Preview must never share Production's).
SUPABASE_SECRET_KEY=               # only imported from platform/system-db
BOOKING_TOKEN_SECRET=              # >= 32 random chars; BOOKING_TOKEN_SECRET_PREVIOUS keeps old links valid during rotation

# Notifications (stage 6). Outside production the e-mail provider defaults to "fake" (nothing is sent).
EMAIL_PROVIDER=                    # resend | fake  (production: resend, the fake provider is refused)
RESEND_API_KEY=                    # sending-only key, one per environment
EMAIL_FROM=                        # e.g. "Tori <noreply@your-verified-domain>" (needs SPF/DKIM/DMARC)
RESEND_WEBHOOK_SECRET=             # whsec_... from the Resend webhook (email.bounced, email.complained) → /api/webhooks/resend
NOTIFICATIONS_PEPPER=              # required in production: keys the HMAC of e-mail addresses (suppression list, log)
CRON_SECRET=                       # >= 16 chars; Vercel Cron sends it as "Authorization: Bearer ..." to /api/jobs/*
APP_URL=                           # absolute site URL used in e-mail links (falls back to NEXT_PUBLIC_SITE_URL)

# Billing (stage 9). The provider is a plug-in: "manual" (no payment provider; a platform admin records the subscription) or "fake" (dev/CI only, refused in production).
# A real provider is one more adapter in modules/billing/adapters + one line in modules/billing/config.ts; its keys go here.
BILLING_PROVIDER=                  # manual | fake  (production default: manual)
BILLING_WEBHOOK_SECRET=            # fake provider only: HMAC secret of its signed webhook → /api/webhooks/billing/fake
